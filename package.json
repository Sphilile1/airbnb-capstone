{
  "name": "airbnb-capstone",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend && npm install --prefix admin",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:admin": "npm run dev --prefix admin",
    "start": "npm start --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build:admin": "npm run build --prefix admin",
    "test": "npm test --prefix backend",
    "heroku-postbuild": "npm install --omit=dev --prefix backend"
  },
  "engines": {
    "node": ">=20 <23"
  }
}
